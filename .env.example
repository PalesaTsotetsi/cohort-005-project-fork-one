# Copy to .env and fill in. .env is gitignored.

# Postmark (optional): without it, emails are written to .outbox/
POSTMARK_SERVER_TOKEN=

# Knock: Development environment (Dashboard → Developers → API keys)
# Public key, safe in the browser (pk_test_…)
KNOCK_PUBLIC_API_KEY=
# Secret key, server only (sk_test_…)
KNOCK_SECRET_API_KEY=
# Signing key for per-user tokens (enhanced security), server only.
# Paste the private key PEM on one line with literal \n, or base64-encode it.
KNOCK_SIGNING_KEY=
# The in-app feed channel id (Dashboard → Integrations → Channels)
KNOCK_FEED_CHANNEL_ID=

# Knock Management API, only for `npm run knock:enrollments-off`.
# Account service token (Dashboard → Settings → Service tokens; knock_st_…).
# It is account-wide, so KNOCK_ENVIRONMENT picks the environment to write.
KNOCK_SERVICE_TOKEN=
KNOCK_ENVIRONMENT=development
